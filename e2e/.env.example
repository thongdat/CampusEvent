# Sao chép file này thành ".env" rồi chỉnh cho khớp môi trường của bạn.
# Playwright sẽ KHÔNG tự đọc .env; hãy nạp bằng dotenv hoặc set trực tiếp biến môi trường.
# Cách nhanh (PowerShell): gán biến rồi chạy test.
#   $env:BASE_URL="http://localhost:8081/api/"; npm test

# URL gốc của app (nhớ dấu "/" ở cuối)
BASE_URL=http://localhost:8081/api/

# Tài khoản demo (mật khẩu phải >= 8 ký tự để qua validate phía client)
E2E_ADMIN_EMAIL=aems.admin01@uni.edu.vn
E2E_ADMIN_PASSWORD=Campus@2026

E2E_DEPARTMENT_EMAIL=dept01@uni.edu.vn
E2E_DEPARTMENT_PASSWORD=Campus@2026

E2E_COMMITTEE_EMAIL=committee01@uni.edu.vn
E2E_COMMITTEE_PASSWORD=Campus@2026

E2E_STUDENT_EMAIL=student001@uni.edu.vn
E2E_STUDENT_PASSWORD=Campus@2026

E2E_LOCKED_EMAIL=locked@example.com
E2E_LOCKED_PASSWORD=locked123
